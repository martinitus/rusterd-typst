#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

cargo build --release --target wasm32-unknown-unknown
cp target/wasm32-unknown-unknown/release/rusterd.wasm rusterd.wasm

output=target/rusterd-typst-check.pdf

typst compile check.typ "$output"
printf '%s\n' "Typst compilation succeeded: $output"
